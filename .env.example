# AgentBreak Environment Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Execution Mode: deterministic | live
MODE=live

# Persistence
DATABASE_URL=sqlite:///./agentbreak.db

# Optional Live LLM API Keys (Phase B live model adapter)
# Set MODE=live to enable real LLM tool-calling (defaults to deterministic fallback if not set)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b
